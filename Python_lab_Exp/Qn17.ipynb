   "source": [
    "# AIM: To count number of lines and words in a file."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "24473463-3e91-4ecc-a022-08b4a540185c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Lines: 2\n",
      "Words: 6\n"
     ]
    }
   ],
   "source": [
    "with open(r\"C:\\Users\\Asus\\database\\test.txt\", \"r\") as f:\n",
    "    data = f.read()\n",
    "\n",
    "print(\"Lines:\", data.count(\"\\n\") + 1)\n",
    "print(\"Words:\", len(data.split()))"
   ]
